; GLITCH BRAWL – Godot-Projektdatei

config_version=5

[application]

config/name="GLITCH BRAWL"
config/description="2D-Multiplayer-Arena-Brawler"
config/version="0.2.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.043, 0.059, 0.102, 1)
boot_splash/show_image=false

[autoload]

Game="*res://scripts/autoload/game.gd"
Net="*res://scripts/net/net.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=4

[gui]

theme/custom_font="res://assets/fonts/pixel.fnt"
theme/default_font_antialiasing=0

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.043, 0.059, 0.102, 1)
